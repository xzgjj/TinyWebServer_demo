{
  "version": 4,
  "configurations": [
    {
      "name": "Linux-WSL2",
      "compileCommands": "${workspaceFolder}/build/compile_commands.json",
      "includePath": [
        "${workspaceFolder}/include",
        "${workspaceFolder}/include/reactor",
        "${workspaceFolder}/include/common",
        "${workspaceFolder}/include/error",
        "${workspaceFolder}/include/timer",
        "${workspaceFolder}/include/config",
        "${workspaceFolder}/include/logging",
        "${workspaceFolder}/include/http",
        "${workspaceFolder}/include/http2",
        "${workspaceFolder}/include/plugin",
        "${workspaceFolder}/include/platform",
        "${workspaceFolder}/third_party"
      ],
      "cStandard": "c17",
      "cppStandard": "c++23",
      "intelliSenseMode": "linux-gcc-x64"
    },
    {
      "name": "Windows-MSYS2-UCRT64",
      "compileCommands": "${workspaceFolder}/build/compile_commands.json",
      "includePath": [
        "${workspaceFolder}/include",
        "${workspaceFolder}/include/reactor",
        "${workspaceFolder}/include/common",
        "${workspaceFolder}/include/error",
        "${workspaceFolder}/include/timer",
        "${workspaceFolder}/include/config",
        "${workspaceFolder}/include/logging",
        "${workspaceFolder}/include/http",
        "${workspaceFolder}/include/platform",
        "${workspaceFolder}/third_party",
        "C:/msys64/ucrt64/include"
      ],
      "cStandard": "c17",
      "cppStandard": "c++23",
      "intelliSenseMode": "windows-gcc-x64",
      "defines": ["WIN32_LEAN_AND_MEAN", "NOMINMAX"]
    }
  ]
}
